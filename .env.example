# Spring Boot imports this file via spring.config.import.
spring.profiles.active=web

RDSHOST=nitrogen-postgres.example.ap-southeast-1.rds.amazonaws.com
NITROGEN_ENVIRONMENT=dev
NITROGEN_DB_URL=jdbc:postgresql://${RDSHOST}:5432/nitrogen?sslmode=require
NITROGEN_DB_USER=nitrogen_app
NITROGEN_DB_PASSWORD=change-me
